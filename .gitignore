# -- generic files to ignore --

# emacs backup files
*~
# vim backup files
*.swp
# NFS file
.nfs*

# -- compiler-related --

# object files
# NOTE: This will result in git also exluding the top-level obj directory
# since its only contents are .o files.
*.o
# static library archives
# NOTE: This will result in git also exluding the top-level lib directory
# since its only contents are .a files.
*.a
*.so
*.so.*
# test executables
*.x
*.pexe
*.nexe
*.js
# WebAssembly binaries and preload bundles emitted by emcc alongside *.x
*.wasm
*.data
# link map files
*.map

# -- build system files --

config.mk
bli_config.h
bli_addon.h

# -- monolithic headers --

include/*/*.h

# -- makefile fragments --

.fragment.mk

# -- misc. --

# BLIS testsuite output file
output.testsuite
output.testsuite.*

# WASM CI artifacts (ci/wasm/do_wasm.sh)
wasm-artifacts/

# WASM semicolon-lapack integration scratch dirs (ci/wasm/do_lapack.sh)
wasm-lapack-work/
wasm-deps/
wasm-prefix/
ci/wasm/__pycache__/

# BLAS test output files
out.*

# GTAGS database
GPATH
GRTAGS
GTAGS

# Mac DS.store files
.DS_Store
